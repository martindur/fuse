// Blend low water into turquoise, then fade the highest areas toward white.
let height = surface.position
  .y()
  .add(0.15)
  .multiply(3.333333)
  .clamp(0.0, 1.0);

let water = rgb(0.01, 0.05, 0.2)
  .mix(rgb(0.05, 0.65, 0.7), height);

let crest = height
  .add(-0.75)
  .multiply(4.0)
  .clamp(0.0, 1.0);

// Ambient light keeps slopes visible when they face away from the light.
let light = vec3(-0.8, 0.6, 0.4)
  .normalize();

let diffuse = surface.normal
  .dot(light)
  .clamp(0.0, 1.0);

let brightness = diffuse
  .multiply(0.8)
  .add(0.2);

let color = water
  .mix(rgb(0.9, 0.98, 1.0), crest)
  .multiply(brightness);

// An artistic screen-space fade; this is independent of the water's UVs.
let fade = screen.uv
  .y()
  .add(-0.2)
  .multiply(1.25)
  .clamp(0.0, 1.0);

let background = rgb(0.06, 0.09, 0.14);

let faded = color
  .mix(background, fade);

vec4(faded, 1.0)
