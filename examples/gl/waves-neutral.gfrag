// A neutral surface makes the wave slopes and triangle density easy to judge.
// Direction points from the surface toward a light in mesh-local coordinates.
let light = vec3(-0.8, 0.6, 0.4)
  .normalize();
let diffuse = normal
  .dot(light)
  .clamp(0.0, 1.0);
let brightness = diffuse
  .multiply(0.8)
  .add(0.2);
let color = rgb(0.65, 0.65, 0.65)
  .multiply(brightness);
vec4(color, 1.0)
